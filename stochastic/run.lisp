(in-package :ggs/stochastic)

(declaim (inline fastlog2 fastexp2))
(eval-always
  (defun fastlog2 (p)
    "Compute log2(P) approximately for *positive* integer P."
    (declare (optimize speed) (fixnum p))
    (let* ((exponent (1- (integer-length p)))
           (x (scale-float (coerce p 'single-float) (- exponent))))
      (declare (type single-float x))
      (+ exponent (- (* -0.4326728 x (- x 5.261706)) 1.8439242)))))

(declaim (inline fastexp2))
(defun constant-for-fastexp2 (base)
  (values (floor (* (expt 2 23) (log base 2)))))
(defun fastexp2 (p base-constant)
  (declare (optimize speed (safety 0))
           (fixnum p base-constant))
  ;; P is a difference of costs, so |P| <= +INF-COST+, and STOCHASTIC-SEARCH-1
  ;; checks that +INF-COST+ * BASE-CONSTANT is a fixnum.

  ;; BITS-SINGLE-FLOAT is monotone for positive floats
  (float-features:bits-single-float
   (max 0 (min (float-features:single-float-bits 1e20)
               (+ (the fixnum (* p base-constant))
                  (- (ash 127 23) 366393))))))

(defun analyses-alist (cost proxy-cost analyses)
  (mapcar (lambda (a) (cons a (get-analysis a)))
          (remove-duplicates (list* proxy-cost cost analyses) :from-end t)))

(defun expand-template (tmpl offset)
  (labels ((process (tmpl)
             (cond
               ((consp tmpl)
                ;; The APPEND may look atrocious but it does not actually cons
                ;; at all, because :ARGS to MAEK-ROSE-NODE optimizes any mix of
                ;; APPEND and LIST (compiler macro generated by
                ;; DEFINE-VARIADIC-STRUCTURE)
                (let ((fsym (if (var-p (car tmpl)) (car tmpl) `',(car tmpl)))
                      (args `(append
                              ,@(mapcar (lambda (arg)
                                          (if (seq-var-p arg) arg `(list ,(process arg))))
                                        (cdr tmpl)))))
                  `(if ,(if (find-if-not #'seq-var-p (cdr tmpl)) t `(or ,@(cdr tmpl)))
                       (finalize-node (make-rose-node :offset ,offset :fsym ,fsym :args ,args)
                                      beta-constant)
                       ,fsym)))
               ((var-p tmpl) tmpl)
               (t `',tmpl))))
   (process tmpl)))

(defun compute-rule-set-lambda (rules cost proxy-cost analyses-alist user-decls)
  (let ((type (getf (assoc-value analyses-alist proxy-cost) :type)))
    (unless (subtypep type 'cost)
      (warn 'simple-style-warning
            :format-control "Cost analysis ~S has :TYPE ~S, which is not a subtype of COST."
            :format-arguments (list proxy-cost type))))

  (bind ((offset (+ +rose-node-args-offset+ (length analyses-alist)))
         ((:flet wrap-user-decls (rule))
          `(,(car rule) (locally (declare ,@user-decls) ,@(cdr rule))))
         (compound-matcher `(do-match* ,offset compound subject
                              ,@(mapcar #'wrap-user-decls rules)))
         (constant-matcher `(do-match* ,offset constant arg
                              ,@(mapcar #'wrap-user-decls rules))))

    ;; FIXME: skip trailing constant loop if constant-matcher can never match
    `(lambda ()
       (declare (optimize speed (safety 0)))
       (macrolet ((get-analysis-data (name term &environment env)
                    (expand-analysis-access ,offset name ',analyses-alist term env))
                  (term (tmpl)
                    (expand-template tmpl ,offset)))
         (labels ((finalize-node (subject beta-constant)
                    (declare (rose-node subject)
                             (fixnum beta-constant)
                             (ignorable beta-constant))
                    (macrolet ((yield-rewrite (rhs)
                                 `(locally (declare (optimize speed (safety 0)))
                                    (incf (rose-node-n-rewrites subject))
                                    (incf (rose-node-weight subject)
                                          (fastexp2 (- cost (get-analysis-data ,',proxy-cost
                                                                               (term ,rhs)))
                                                    beta-constant)))))

                      ;; rewrites inside the arguments
                      (setf (rose-node-n-rewrites subject) 0)
                      (do-variadic-slots (arg ,offset subject)
                        (when (rose-node-p arg)
                          (incf (rose-node-n-rewrites subject) (rose-node-n-rewrites arg))
                          (incf (rose-node-weight subject) (rose-node-weight arg))))

                      ;; compute analyses
                      (setf ,@(loop for (_ . analysis) in analyses-alist
                                    for i from 0
                                    append
                                    `((svref subject (+ +rose-node-args-offset+ ,i))
                                      ,(expand-analysis offset analysis 'compound 'subject))))

                      ;;compute weights
                      (let ((cost (get-analysis-data ,proxy-cost subject)))
                        (declare (type cost cost) (ignorable cost))
                        ,compound-matcher)

                      (do-variadic-slots (arg ,offset subject)
                        (unless (rose-node-p arg)
                          (let ((cost (get-analysis-data ,proxy-cost arg)))
                            (declare (type cost cost) (ignorable cost))
                            ,constant-matcher)))
                      subject))

                  (sample-inf-temp (subject n-rewrites beta-constant)
                    (declare (rose-node subject)
                             (fixnum n-rewrites beta-constant)
                             (ignorable n-rewrites beta-constant))
                    (macrolet ((yield-rewrite (rhs)
                                 `(locally (declare (optimize speed (safety 0)))
                                    (decf n-rewrites)
                                    (when (minusp n-rewrites)
                                      (return-from sample
                                        (values (context (term ,rhs)) %current-ruleset%))))))
                      (block sample
                        (macrolet ((context (rhs) rhs))
                          ,compound-matcher)
                        (do-variadic-slots ((arg i) ,offset subject)
                          (unless (rose-node-p arg)
                            (macrolet ((context (rhs)
                                         `(finalize-node (node-replace-arg subject i ,rhs ,',offset)
                                                         beta-constant)))
                              ,constant-matcher)))
                        subject)))

                  (sample-fin-temp (subject weight beta-constant)
                    (declare (rose-node subject)
                             (single-float weight)
                             (fixnum beta-constant)
                             (ignorable weight beta-constant))
                    (macrolet ((yield-rewrite (rhs)
                                 `(locally (declare (optimize speed (safety 0)))
                                    (decf weight (fastexp2
                                                  (- cost (get-analysis-data ,',proxy-cost
                                                                             (term ,rhs)))
                                                  beta-constant))
                                    (when (minusp weight)
                                      (return-from sample
                                        (values (context (term ,rhs)) %current-ruleset%))))))
                      (block sample
                        (let ((cost (get-analysis-data ,proxy-cost subject)))
                          (declare (type cost cost) (ignorable cost))
                          (macrolet ((context (rhs) rhs))
                            ,compound-matcher))
                        (do-variadic-slots ((arg i) ,offset subject)
                          (unless (rose-node-p arg)
                            (let ((cost (get-analysis-data ,proxy-cost arg)))
                              (declare (type cost cost) (ignorable cost))
                              (macrolet ((context (rhs)
                                           `(finalize-node (node-replace-arg subject i ,rhs ,',offset)
                                                           beta-constant)))
                                ,constant-matcher))))
                        subject)))

                  (get-cost (node)
                    ,(expand-analysis-access offset cost analyses-alist 'node nil)))

           (list 'finalize-node #'finalize-node
                 'sample-inf-temp #'sample-inf-temp
                 'sample-fin-temp #'sample-fin-temp
                 'get-cost #'get-cost))))))

(defun get-rules-resolve-symbols (name)
  (mapcan (lambda (rule)
            (if (symbolp rule)
                (get-rules-resolve-symbols rule)
                ;; Also annotate what ruleset it comes from, for
                ;; :SAVE-FULL-HISTORY
                (list `(,(car rule)
                        (symbol-macrolet ((%current-ruleset% ',name))
                          ,@(cdr rule))))))
          (get-rules name)))

(defparameter *compiled-rule-sets* (make-hash-table :test 'equal))

(defmacro precompile-stochastic-rule-set (name cost &key (proxy-cost cost) analyses
                                          &environment env)
  "Compile rule set NAME at compile time for STOCHASTIC-SEARCH with the same COST,
PROXY-COST and ANALYSES (unevaluated)."
  (let ((rules (get-rules-resolve-symbols name))
        (user-decls (get-user-decls env))
        (analyses-alist (analyses-alist cost proxy-cost analyses)))
    `(let ((rules ',rules))
       (unless (equal rules (get-rules-resolve-symbols ',name))
         (warn "Rule set ~A changed between compile and load time" ',name))
       (setf (gethash (list rules ',cost ',proxy-cost ',analyses-alist ',user-decls)
                      *compiled-rule-sets*)
             (funcall ,(compute-rule-set-lambda
                        rules cost proxy-cost analyses-alist user-decls))))))

(defun compiled-rule-set (name cost proxy-cost analyses-alist)
  (let ((rules (get-rules-resolve-symbols name))
        (user-decls (get-user-decls nil))
        (analyses (remove proxy-cost (remove cost (mapcar #'car analyses-alist)))))
    (ensure-gethash (list rules cost proxy-cost analyses-alist user-decls)
                    *compiled-rule-sets*
                    (progn
                      (warn 'runtime-compile-warning
                            :form `(precompile-stochastic-rule-set
                                    ,name ,cost
                                    ,@(unless (eql proxy-cost cost)
                                        `((:proxy-cost ,proxy-cost)))
                                    ,@(when analyses
                                        `((:analyses ,analyses)))))
                      (funcall (compile nil
                                        (compute-rule-set-lambda
                                         rules cost proxy-cost analyses-alist user-decls)))))))

(defun stochastic-search-1
    (init-term rule-set cost
     &key (finish-flag (list nil)) (seed 0) (stride 1)
       (beta 2.0) (soft-walk 0) (soft-stall nil) (hard-walk soft-walk) (max-stall 16000)
       (target-cost 0) max-time (max-restart 64)
       (proxy-cost cost) analyses
       verbose save-cost-history save-full-history)
  (declare ((or null integer) soft-stall max-restart)
           (integer hard-walk soft-walk)
           (single-float beta))
  (bind ((analyses-alist (analyses-alist cost proxy-cost analyses))
         (offset (+ +rose-node-args-offset+ (length analyses-alist)))
         ((finalize-node sample-inf-temp sample-fin-temp get-cost)
          (mapcar (curry #'getf (compiled-rule-set rule-set cost proxy-cost analyses-alist))
                  '(finalize-node sample-inf-temp sample-fin-temp get-cost)))
         (start-time (get-internal-real-time))
         (end-time (and max-time
                        (+ start-time
                           (* max-time internal-time-units-per-second))))
         (beta-constant (constant-for-fastexp2 (exp (/ beta 2))))
         (last-fired-ruleset nil) ; recorded for :SAVE-FULL-HISTORY
         ((:flet wrap-sampler (s))
          (if save-full-history
              (lambda (subject weight beta-constant)
                (multiple-value-bind (result ruleset)
                    (funcall s subject weight beta-constant)
                  (setq last-fired-ruleset ruleset)
                  result))
              s))
         (inf-sampler (wrap-sampler sample-inf-temp))
         (fin-sampler (wrap-sampler sample-fin-temp))
         (init-node (progn
                      (unless (<= (* +inf-cost+ beta-constant) most-positive-fixnum)
                        (error "BETA ~A is too large." beta))
                      (term-node init-term offset finalize-node beta-constant)))
         (init-cost (funcall get-cost init-node))
         (best-term (node-term init-node offset))
         (best-cost init-cost)
         (n-accepted 0)
         (n-restart 0)
         (cost-history '())
         (full-history '()))
    (declare (function get-cost))

    (float-features:with-float-traps-masked t
      ;; Outer loop: restart with different seeds
      (block solve
        (loop for seed-1 from seed by stride do
          ;; Inner loop: one run of stochastic search
          (let* ((*random-state* (sb-ext:seed-random-state seed-1))
                 (node init-node)
                 (best-cost-1 init-cost)
                 (n-stall 0)
                 (best-cost-soft init-cost)
                 (n-stall-soft 0)
                 (n-walk hard-walk))
            (declare (integer n-accepted n-restart n-stall n-stall-soft n-walk))
            (when (and max-restart (>= seed-1 (+ seed max-restart)))
              (return))
            (when save-full-history
              (push (nreverse (list :seed seed-1 (list :term init-term :cost init-cost)))
                    full-history))
            (incf n-restart)
            (loop for i of-type fixnum from 0 do
              (progn
                (when (or (car finish-flag)
                          ;; Check time every 1024 iters, because
                          ;; GET-INTERNAL-REAL-TIME is slow
                          (and end-time
                               (zerop (mod i 1024))
                               (>= (get-internal-real-time) end-time)))
                  (return-from solve))

                ;; FIXME: a constant top-level NODE might still be rewritable,
                ;; although this probably is not usually useful.
                (when (or (not (rose-node-p node))
                          (zerop (rose-node-n-rewrites node)))
                  (return-from solve))

                (cond ((plusp n-walk)
                       (decf n-walk)
                       (setq node
                             (search-rewrite-n-rewrites
                              node offset (random (rose-node-n-rewrites node))
                              inf-sampler finalize-node beta-constant)))
                      (t
                       (setq node
                             (search-rewrite-weight
                              node offset (random (rose-node-weight node))
                              fin-sampler finalize-node beta-constant))))

                (incf n-accepted)
                (let ((cost (funcall get-cost node)))
                  (when save-full-history
                    (push (list :term (node-term node offset)
                                :cost cost
                                :ruleset last-fired-ruleset)
                          (car full-history)))
                  ;; Check for cost function decrease
                  (if (< cost best-cost-1)
                      (progn
                        (when verbose
                          (format t "~&Iteration ~a/~a found ~a ~a~%"
                                  seed-1 i cost (node-term node offset)))
                        (setq best-cost-1 cost
                              n-stall 0)
                        (when (< cost best-cost)
                          (setq best-cost cost
                                best-term (node-term node offset))
                          (when save-cost-history
                            (push (list (- (get-internal-real-time) start-time) cost)
                                  cost-history))
                          (when (<= cost target-cost)
                            (setf (car finish-flag) t)
                            (return-from solve))))
                      (incf n-stall))

                  ;; inf-temp walk (soft restart) bookkeeping
                  (if (or (plusp n-walk) (< cost best-cost-soft))
                      (setq best-cost-soft cost
                            n-stall-soft 0)
                      (incf n-stall-soft))
                  (when (and soft-stall (>= n-stall-soft soft-stall))
                    (setq n-walk soft-walk
                          n-stall-soft 0))

                  ;; Check for restart
                  (unless (and (< n-stall max-stall)
                               (< cost +inf-cost+))
                    (when verbose
                      (format t "~&Iteration ~a/~a restart ~a ~a~%"
                              seed-1 i cost (node-term node offset)))
                    (return)))))))))
    (values best-cost best-term
            `( :n-accepted ,n-accepted :n-restart ,n-restart
               ,@(when save-cost-history
                   `(:cost-history ,(nreverse cost-history)))
               ,@(when save-full-history
                   `(:full-history ,(nreverse (mapcar #'nreverse full-history))))))))

(defun merge-cost-history (st1 st2)
  "Merge two time-ordered (TIME COST) lists, keeping only strict improvements."
  (let ((st '())
        (best-cost +inf-cost+))
    (loop
      (when (or (not st1) (and st2 (>= (caar st1) (caar st2))))
        (rotatef st1 st2))
      (when (not st1) (return))
      (when (< (cadar st1) best-cost)
        (setq best-cost (cadar st1))
        (push (car st1) st))
      (pop st1))
    (nreverse st)))

(defun reduce-stochastic-result (results-1 results-2)
  (bind (((bc1 bt1 plist1) results-1)
         ((bc2 bt2 plist2) results-2)
         ((:plist (na1 :n-accepted)
                  (nr1 :n-restart)
                  (st1 :cost-history 'unbound)
                  (fh1 :full-history 'unbound))
          plist1)
         ((:plist (na2 :n-accepted)
                  (nr2 :n-restart)
                  (st2 :cost-history 'unbound)
                  (fh2 :full-history 'unbound))
          plist2))
    `(,@(if (< bc1 bc2) (list bc1 bt1) (list bc2 bt2))
      ( :n-accepted ,(+ na1 na2) :n-restart ,(+ nr1 nr2)
        ,@(unless (eq st1 'unbound)
            `(:cost-history ,(merge-cost-history st1 st2)))
        ,@(unless (eq fh1 'unbound)
            `(:full-history ,(sort (nconc fh1 fh2) #'< :key (lambda (h) (getf h :seed)))))))))

(defun worker-loop ()
  (with-standard-io-syntax
    (loop
      (handler-case
          (prin1 (cons :result (multiple-value-list (eval (read)))))
        (serious-condition (c)
          (prin1 (cons :error (princ-to-string c)))))
      (terpri)
      (finish-output))))

(defun stochastic-search
    (term rule-set cost &rest args
     &key (seed 0) (stride 1)
       (beta 2.0) (soft-walk 0) (soft-stall nil) (hard-walk soft-walk) (max-restart 64)
       (target-cost 0) max-time (max-stall 16000)
       (proxy-cost cost) analyses
       verbose save-cost-history save-full-history
       (nproc 1) workers)
  "Search for a term equivalent to TERM under RULE-SET that minimises COST.

COST and PROXY-COST (default COST) name DEFINE-ANALYSIS analyses whose values are
costs: define them with :MERGE #'MIN, :BOTTOM +INF-COST+ and :TYPE COST.  The
search restarts on reaching a cost of +INF-COST+ or more.  It minimises COST
and weights rewrites by PROXY-COST.  ANALYSES names further analyses the rules
use.  Return the best cost, the best term and a plist of statistics."
  (declare (ignore beta
                   max-stall max-restart soft-stall hard-walk
                   target-cost max-time
                   verbose save-cost-history save-full-history))
  (cond (workers
         (let ((n-workers (length workers)))
           (multiple-value-bind (nproc rem) (floor nproc n-workers)
             (loop for proc in workers
                   for i from 0
                   for nproc-1 = (if (< i rem) (1+ nproc) nproc)
                   do (with-standard-io-syntax
                        (write `(apply #'stochastic-search
                                       ',term ',rule-set ',cost
                                       :seed ',(+ seed (* i stride))
                                       :stride ',(* n-workers stride)
                                       :nproc ',nproc-1
                                       ',(remove-from-plist args :workers :nproc :seed :stride))
                               :stream (uiop:process-info-input proc))
                        (terpri (uiop:process-info-input proc))
                        (finish-output (uiop:process-info-input proc)))))
           (values-list
            (reduce #'reduce-stochastic-result workers :key
                    (lambda (proc)
                      (let ((result (with-standard-io-syntax
                                      (read (uiop:process-info-output proc)))))
                        (ecase (car result)
                          (:result (cdr result))
                          (:error (error "Error in worker: ~a" (cadr result))))))))))
        ((> nproc 1)
         ;; Compile rule sets in main thread only
         (compiled-rule-set rule-set cost proxy-cost
                            (analyses-alist cost proxy-cost analyses))
         (let* ((finish-flag (list nil))
                (threads (mapcar
                          (lambda (i)
                            (bt:make-thread
                             (lambda ()
                               (multiple-value-list
                                (apply #'stochastic-search-1 term rule-set cost
                                       :seed (+ seed (* i stride))
                                       :stride (* nproc stride)
                                       :finish-flag finish-flag
                                       (remove-from-plist args :workers :nproc :seed :stride))))
                             :name (format nil "search worker ~a" i)))
                                 (iota nproc))))
           (unwind-protect
                (values-list (reduce #'reduce-stochastic-result threads :key #'bt:join-thread))
             (setf (car finish-flag) t))))
        ((= nproc 0) (values +inf-cost+ term (list :n-accepted 0 :n-restart 0)))
        (t (apply #'stochastic-search-1
                  term rule-set cost
                  (remove-from-plist args :nproc :workers)))))
